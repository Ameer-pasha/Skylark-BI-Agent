# ── Smart Attendance System — configuration ───────────────────────────
# Copy this file to .env and adjust values as needed.

FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Face recognition
FACE_MATCH_THRESHOLD=0.45   # cosine similarity threshold (0.45 - 0.5 works well)
DETECTION_THRESHOLD=0.5     # RetinaFace detection confidence
DET_SIZE=640                # detection image size (square)

# Attendance rules
LATE_AFTER=09:15            # students marked after this time are "Late"

# Server
HOST=0.0.0.0
PORT=5000
