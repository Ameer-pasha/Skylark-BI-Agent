# Skylark BI Agent Environment Configuration Example
# Copy to .env and fill in your keys. Missing keys auto-enable offline/sample fallback modes.

# ── monday.com ──
MONDAY_API_TOKEN=your_monday_personal_api_token_here
WORK_ORDERS_BOARD_ID=123456789
DEALS_BOARD_ID=987654321

# ── LLM Provider ──
# Options: auto | anthropic | claude | grok | xai
# auto (default): picks the provider for which a valid API key is set
LLM_PROVIDER=auto

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# xAI Grok (https://console.x.ai/) — OpenAI-compatible at https://api.x.ai/v1
# Get your key from https://console.x.ai → API Keys. Models: grok-3, grok-3-mini, grok-4, grok-4-fast
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3
# Optional overrides (also accepted: GROK_API_KEY, GROK_MODEL)
# GROK_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-3
# XAI_BASE_URL=https://api.x.ai/v1

# ── Backend ──
BACKEND_URL=http://localhost:8000
